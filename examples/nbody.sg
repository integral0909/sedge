// The n-body simulation of the Jovian planets, as in the Computer Language
// Benchmarks Game. Pass the number of steps as an argument.

struct Body {
    x: Float, y: Float, z: Float,
    vx: Float, vy: Float, vz: Float,
    mass: Float,
}

fn pi() -> Float { 3.141592653589793 }
fn solar_mass() -> Float { 4.0 * pi() * pi() }
fn days_per_year() -> Float { 365.24 }

fn planet(x: Float, y: Float, z: Float, vx: Float, vy: Float, vz: Float, mass: Float) -> Body {
    let d = days_per_year()
    Body { x, y, z, vx: vx * d, vy: vy * d, vz: vz * d, mass: mass * solar_mass() }
}

fn bodies() -> [Body] {
    [
        Body { x: 0.0, y: 0.0, z: 0.0, vx: 0.0, vy: 0.0, vz: 0.0, mass: solar_mass() },
        planet(4.84143144246472090e+00, -1.16032004402742839e+00, -1.03622044471123109e-01,
               1.66007664274403694e-03, 7.69901118419740425e-03, -6.90460016972063023e-05,
               9.54791938424326609e-04),
        planet(8.34336671824457987e+00, 4.12479856412430479e+00, -4.03523417114321381e-01,
               -2.76742510726862411e-03, 4.99852801234917238e-03, 2.30417297573763929e-05,
               2.85885980666130812e-04),
        planet(1.28943695621391310e+01, -1.51111514016986312e+01, -2.23307578892655734e-01,
               2.96460137564761618e-03, 2.37847173959480950e-03, -2.96589568540237556e-05,
               4.36624404335156298e-05),
        planet(1.53796971148509165e+01, -2.59193146099879641e+01, 1.79258772950371181e-01,
               2.68067772490389322e-03, 1.62824170038242295e-03, -9.51592254519715870e-05,
               5.15138902046611451e-05),
    ]
}

fn offset_momentum(bs: [Body]) {
    var px = 0.0
    var py = 0.0
    var pz = 0.0
    for b in bs {
        px += b.vx * b.mass
        py += b.vy * b.mass
        pz += b.vz * b.mass
    }
    let sun = bs[0]
    sun.vx = -px / solar_mass()
    sun.vy = -py / solar_mass()
    sun.vz = -pz / solar_mass()
}

fn energy(bs: [Body]) -> Float {
    var e = 0.0
    let n = bs.len()
    for i in 0..n {
        let b = bs[i]
        e += 0.5 * b.mass * (b.vx * b.vx + b.vy * b.vy + b.vz * b.vz)
        for j in i + 1..n {
            let c = bs[j]
            let dx = b.x - c.x
            let dy = b.y - c.y
            let dz = b.z - c.z
            e -= b.mass * c.mass / (dx * dx + dy * dy + dz * dz).sqrt()
        }
    }
    e
}

fn advance(bs: [Body], dt: Float) {
    let n = bs.len()
    for i in 0..n {
        let b = bs[i]
        for j in i + 1..n {
            let c = bs[j]
            let dx = b.x - c.x
            let dy = b.y - c.y
            let dz = b.z - c.z
            let d2 = dx * dx + dy * dy + dz * dz
            let mag = dt / (d2 * d2.sqrt())
            b.vx -= dx * c.mass * mag
            b.vy -= dy * c.mass * mag
            b.vz -= dz * c.mass * mag
            c.vx += dx * b.mass * mag
            c.vy += dy * b.mass * mag
            c.vz += dz * b.mass * mag
        }
    }
    for b in bs {
        b.x += dt * b.vx
        b.y += dt * b.vy
        b.z += dt * b.vz
    }
}

fn main() {
    let steps = match args().first() {
        Some(s) => s.parse_int().unwrap_or(1000),
        None => 1000,
    }
    let bs = bodies()
    offset_momentum(bs)
    print(energy(bs).fixed(9))
    for _ in 0..steps {
        advance(bs, 0.01)
    }
    print(energy(bs).fixed(9))
}
