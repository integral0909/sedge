struct Stack[T] { items: [T] }

impl Stack[T] {
    fn new() -> Stack[T] { Stack { items: [] } }
    fn push(self, x: T) { self.items.push(x) }
    fn pop(self) -> Option[T] { self.items.pop() }
    fn peek(self) -> Option[T] { self.items.last() }
    fn size(self) -> Int { self.items.len() }
}

enum Tree[T] { Leaf, Node(Tree[T], T, Tree[T]) }

fn insert[T: Ord](t: Tree[T], x: T) -> Tree[T] {
    match t {
        Leaf => Node(Leaf, x, Leaf),
        Node(l, v, r) => if x < v {
            Node(insert(l, x), v, r)
        } else {
            Node(l, v, insert(r, x))
        },
    }
}

fn to_list[T](t: Tree[T], out: [T]) {
    match t {
        Leaf => {},
        Node(l, v, r) => {
            to_list(l, out)
            out.push(v)
            to_list(r, out)
        }
    }
}

fn sum[T: Num](xs: [T], zero: T) -> T {
    var acc = zero
    for x in xs { acc = acc + x }
    acc
}

fn pair_up[A, B](a: A, b: B) -> (A, B) { (a, b) }

fn main() {
    let s = Stack.new()
    s.push("a")
    s.push("b")
    print(s.peek())
    print(s.pop())
    print(s.size())

    var t = Leaf
    for x in [5, 2, 8, 1, 9, 3] {
        t = insert(t, x)
    }
    let out = []
    to_list(t, out)
    print(out)

    var words = Leaf
    for w in ["pear", "fig", "apple"] { words = insert(words, w) }
    let ws: [String] = []
    to_list(words, ws)
    print(ws)

    print(sum([1, 2, 3], 0))
    print(sum([0.5, 0.25], 0.0))
    print(pair_up(1, "one"))
}
//> Some("b")
//> Some("b")
//> 1
//> [1, 2, 3, 5, 8, 9]
//> ["apple", "fig", "pear"]
//> 6
//> 0.75
//> (1, "one")
