fn main() {
    var xs = [3, 1, 4, 1, 5, 9, 2, 6]
    print(xs.len())
    xs.push(5)
    print(xs.pop())
    print(xs.sorted())
    print(xs)
    xs.sort_by(fn(a, b) => b - a)
    print(xs)
    print(xs.contains(9))
    print(xs.index_of(4))
    print(xs.slice(1, 3))
    print(xs.take(2).concat(xs.skip(6)))
    xs.reverse()
    print(xs.first())
    print(xs.last())
    print([].first() == None)
    print(xs.max())
    print(xs.min())
    print(xs.map(fn(x) => x * x).filter(fn(x) => x > 10))
    print(xs.any(fn(x) => x > 8))
    print(xs.all(fn(x) => x > 0))
    print(xs.count(fn(x) => x == 1))
    print(xs.find(fn(x) => x > 4))
    print(xs.position(fn(x) => x == 5))
    print(["a", "b"].enumerate())
    print([1, 2, 3].zip(["x", "y"]))
    print([[1], [2, 3]].flat_map(fn(v) => v))
    print([1, 2, 3].join(" - "))
    print(Array.filled(0, 3))
    xs.insert(0, 100)
    print(xs.remove(0))
    xs.clear()
    print(xs.is_empty())

    let grid = [[1, 2], [3, 4]]
    grid[1][0] = 30
    print(grid)

    let m = Map.new()
    m["one"] = 1
    m["two"] = 2
    m.set("three", 3)
    print(m)
    print(m.len())
    print(m.get("two"))
    print(m.get("zero"))
    print(m["three"])
    print(m.contains("one"))
    print(m.remove("one"))
    print(m.keys())
    print(m.values())
    print(m.entries())
    m.update("two", 0, fn(v) => v * 10)
    m.update("four", 0, fn(v) => v + 4)
    print(m)
    print(m.get_or("five", -1))

    let counts: Map[String, Int] = Map.new()
    for w in "a b a c b a".split(" ") {
        counts[w] = counts.get_or(w, 0) + 1
    }
    print(counts)
    var pairs = counts.entries()
    pairs.sort_by(fn(p, q) => q.1 - p.1)
    print(pairs[0])
    print([(2, "b"), (1, "z"), (2, "a")].sorted())
}
