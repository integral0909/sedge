fn find_first_even(xs: [Int]) -> Option[Int] {
    for x in xs {
        if x % 2 == 0 {
            return Some(x)
        }
    }
    None
}

fn collatz(n: Int) -> Int {
    var steps = 0
    var m = n
    while m != 1 {
        m = if m % 2 == 0 { m / 2 } else { 3 * m + 1 }
        steps += 1
    }
    steps
}

fn grade(score: Int) -> String {
    if score >= 90 {
        "A"
    } else if score >= 80 {
        "B"
    } else {
        "C"
    }
}

fn main() {
    print(find_first_even([1, 3, 6, 8]))
    print(find_first_even([1, 3]))
    print(collatz(27))
    print([95, 85, 20].map(grade))

    var out = []
    for i in 0..10 {
        if i == 7 { break }
        if i % 2 == 1 { continue }
        out.push(i)
    }
    print(out)

    var total = 0
    for i in 1..=4 {
        for j in 1..=i {
            if j == 3 { continue }
            total += j
        }
    }
    print(total)

    var n = 0
    while true {
        n += 1
        if n > 3 { break }
    }
    print(n)

    let r = 2..5
    var s = 0
    for i in r { s += i }
    print(s)

    let label = {
        let a = 2
        let b = 3
        a * b
    }
    print(label)
}
