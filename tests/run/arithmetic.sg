// Integer and float arithmetic, precedence and conversions.
fn main() {
    print(1 + 2 * 3 - 4 / 2)
    print(17 % 5)
    print(-17 / 5)
    print(-17 % 5)
    print(2.5 * 4.0)
    print(7.0 / 2.0)
    print(1 << 10 | 3)
    print(0xff & 0x0f ^ 1)
    print(10.to_float() / 4.0)
    print(3.99.to_int())
    print((-2.5).abs())
    print(2.pow(10))
    print(9.0.sqrt())
    print(0.1 + 0.2)
    print(1e3)
    print(255.to_base(16))
    print((-5).abs())
    print(1.0 / 0.0)
    print(3.14159.fixed(2))
    print(7.clamp(0, 5))
    print(max(3, 9))
    print(min("pear", "apple"))
}
//> 5
//> 2
//> -3
//> -2
//> 10.0
//> 3.5
//> 1027
//> 14
//> 2.5
//> 3
//> 2.5
//> 1024
//> 3.0
//> 0.30000000000000004
//> 1000.0
//> ff
//> 5
//> inf
//> 3.14
//> 5
//> 9
//> apple
